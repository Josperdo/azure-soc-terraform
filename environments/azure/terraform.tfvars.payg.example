# ─────────────────────────────────────────────────────────────────────────────
# Azure SOC Terraform — Example Variable Values (Pay-As-You-Go profile)
#
# Tuned for a fully-activated pay-as-you-go subscription that isn't trying to
# stretch free trial credit: Standard-SKU Bastion, longer log retention. On a
# brand-new account still running on free trial credit? See
# terraform.tfvars.example instead.
#
# Copy this file to terraform.tfvars and fill in your real values.
# terraform.tfvars is git-ignored to prevent committing secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Your Azure Subscription ID.
# Find it with: az account show --query id -o tsv
subscription_id = "00000000-0000-0000-0000-000000000000"

# Short prefix for all resource names (lowercase, 2-6 chars).
prefix = "soc"

# Azure region. Run `az account list-locations -o table` for valid values.
# Note: "East US" may have B-series VM capacity restrictions. "East US 2" is recommended.
location = "East US 2"

# Environment label applied as a tag to every resource.
environment = "lab"

# ── Network ──────────────────────────────────────────────────────────────────

vnet_address_space     = ["10.0.0.0/16"]
management_subnet_cidr = "10.0.1.0/24"
workload_subnet_cidr   = "10.0.2.0/24"
bastion_subnet_cidr    = "10.0.3.0/26" # Minimum /26 required by Azure Bastion

# Standard SKU adds native client (az network bastion ssh/rdp), IP-based
# connection, and file copy — worth the extra cost when not preserving trial
# credit. See: https://learn.microsoft.com/en-us/azure/bastion/configuration-settings#skus
bastion_sku = "Standard"

# ── Compute ──────────────────────────────────────────────────────────────────

# Some regions have B-series VM capacity restrictions regardless of subscription
# type. If you see "SkuNotAvailable", use Standard_D2s_v3 as a reliable fallback.
# Upgrade to Standard_D2s_v5 for heavier workloads.
vm_size        = "Standard_B2s"
admin_username = "azureadmin"

# Generate with: ssh-keygen -t rsa -b 4096 -f ~/.ssh/azure_soc_key
# Then paste the contents of ~/.ssh/azure_soc_key.pub below.
admin_ssh_public_key = "ssh-rsa AAAA...your-public-key-here... user@host"

# ── Monitoring ───────────────────────────────────────────────────────────────

# Longer retention than the free-trial profile — PAYG accounts don't need to
# hug the free-tier retention floor to control cost.
log_retention_days = 90

# ── Extra Tags ───────────────────────────────────────────────────────────────

tags = {
  owner = "your-name"
}
